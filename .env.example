# Required for Gemini-powered modules
GEMINI_API_KEY=your_api_key_here

# Current Gemini model; change if your account/project uses another available model.
GEMINI_MODEL=gemini-3.5-flash-lite

# auto = try local LaMini first, then Gemini; gemini = always use Gemini; local = require local model
EXPLANATION_MODE=local
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

MAX_INPUT_CHARS=12000
